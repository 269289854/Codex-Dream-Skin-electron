{
  "name": "codex-dream-skin-studio",
  "version": "1.1.22",
  "description": "Windows and macOS visual theme editor for Codex desktop",
  "main": "dist-electron/main/index.js",
  "author": "Codex Dream Skin contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:config": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File tests/config-utf8.ps1",
    "generate:mac-icons": "node scripts/generate-macos-icons.mjs",
    "package:dir": "npm run build && electron-builder --win --x64 --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac:dir": "npm run build && npm run generate:mac-icons && electron-builder --mac --universal --dir && npm run verify:mac:dir",
    "package:mac": "npm run build && npm run generate:mac-icons && electron-builder --mac --universal --publish never && npm run verify:mac",
    "verify:mac:dir": "node scripts/verify-macos-artifacts.mjs --dir",
    "verify:mac": "node scripts/verify-macos-artifacts.mjs"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "culori": "^4.0.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "ffmpeg-static": "5.3.0",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.468.0",
    "mediainfo.js": "^0.3.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.codexdreamskin.studio",
    "productName": "Codex Dream Skin Studio",
    "beforePack": "scripts/prepare-ffmpeg.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "269289854",
        "repo": "Codex-Dream-Skin-electron"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "icon/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "extraResources": [
      {
        "from": "resources/shared",
        "to": "shared",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/windows/codex-dream-skin.ico",
      "artifactName": "Codex-Dream-Skin-Studio-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "resources/windows",
          "to": "windows",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "resources/macos/codex-dream-skin.icns",
      "identity": null,
      "notarize": false,
      "minimumSystemVersion": "12.0.0",
      "category": "public.app-category.developer-tools",
      "artifactName": "Codex-Dream-Skin-Studio-${version}-mac-${arch}.${ext}",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/@img/{sharp,sharp-libvips}-darwin-*/**/*",
      "extraResources": [
        {
          "from": "resources/macos",
          "to": "macos",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "resources/windows/codex-dream-skin.ico",
      "uninstallerIcon": "resources/windows/codex-dream-skin.ico",
      "installerHeaderIcon": "resources/windows/codex-dream-skin.ico"
    }
  }
}
